#!/bin/sh
# Gradle wrapper script — launches the Gradle wrapper jar.
# JAVA_HOME is inherited from the environment (set to Android Studio's JDK).

set -e

APP_HOME=$(cd "$(dirname "$0")" && pwd -P)
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

exec "$JAVA_HOME/bin/java" \
  -Xmx512m \
  -Xms64m \
  -classpath "$CLASSPATH" \
  org.gradle.wrapper.GradleWrapperMain "$@"
