#!/bin/sh
# gradlew — Gradle wrapper script for Unix/macOS.
# Generated by Gradle; do not modify manually.
# Run `chmod +x gradlew` after checkout if needed.

set -e

APP_NAME="Gradle"
APP_BASE_NAME=$(basename "$0")
APP_HOME=$(cd "$(dirname "$0")" && pwd -P)

# Resolve Gradle home and run the wrapper jar.
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

exec java $DEFAULT_JVM_OPTS -classpath "$CLASSPATH" \
  org.gradle.wrapper.GradleWrapperMain "$@"
