# proguard-rules.pro — ProGuard/R8 rules for the ALI release build.

# Keep JNI-accessible classes intact — the native code references these
# by exact class and method name. Renaming them breaks the JNI bridge.
-keep class com.ali.search.AliEngine {
    native <methods>;
    public *;
}

# Keep data classes used across the Kotlin/JNI boundary.
-keep class com.ali.search.AliEngine$Result { *; }

# WorkManager — keep worker class names for scheduling.
-keep class com.ali.search.AliCrawlerWorker { *; }

# Compose — generated by the Compose compiler; must not be stripped.
-keep class androidx.compose.** { *; }

# Standard Android rules.
-keepattributes *Annotation*
-keepattributes SourceFile,LineNumberTable
